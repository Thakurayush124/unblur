{
  "name": "grasp",
  "private": true,
  "type": "module",
  "workspaces": ["apps/api", "apps/web"],
  "engines": { "node": ">=20.19" },
  "scripts": {
    "dev": "npm run dev -w apps/api & npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "test": "npm run test -w apps/api",
    "e2e": "npm run e2e -w apps/web",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "lint": "eslint apps && prettier --check \"apps/*/src/**/*.{ts,tsx}\" \"apps/*/test/**/*.ts\" \"apps/web/e2e/**/*.ts\"",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx}\" \"apps/*/test/**/*.ts\" \"apps/web/e2e/**/*.ts\""
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
