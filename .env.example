# Mongo connection used by the worker (and later the API)
GRASP_MONGO_URL=mongodb://localhost:27017
GRASP_MONGO_DB=grasp
REDIS_URL=redis://localhost:6379

# Host folder containing repos to analyse (mounted read-only into the worker at /repos)
GRASP_REPOS_DIR=./repos

# ---- LLM (opt-in; OFF by default) ---------------------------------------------
# No source code is sent anywhere unless BOTH of these hold:
#   1. the repo's .grasp.json sets "llmCriticality": true
#   2. GRASP_ALLOW_LLM_CODE=true
GRASP_ALLOW_LLM_CODE=false

# Provider: anthropic | gemini | openai (any OpenAI-compatible endpoint)
# Free options:
#   gemini  - free API key from Google AI Studio (aistudio.google.com). Note: free-tier
#             prompts may be used by Google to improve its products.
#   openai  - Groq free tier:   GRASP_LLM_BASE_URL=https://api.groq.com/openai/v1
#           - OpenRouter free:  GRASP_LLM_BASE_URL=https://openrouter.ai/api/v1  GRASP_LLM_MODEL=<model>:free
#           - Ollama (local, no key, code never leaves your machine):
#                               GRASP_LLM_BASE_URL=http://localhost:11434/v1  GRASP_LLM_MODEL=llama3.2
GRASP_LLM_PROVIDER=gemini
GRASP_LLM_API_KEY=
# Optional overrides (defaults: anthropic=claude-opus-5-5, gemini=gemini-2.5-flash, openai=llama-3.3-70b-versatile)
GRASP_LLM_MODEL=
GRASP_LLM_BASE_URL=

# ---- GitHub App (Phase 4, optional; see docs/github-app.md) -------------------------------
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
# Dashboard URL used for links in checks/comments
GRASP_PUBLIC_URL=http://localhost:4000
